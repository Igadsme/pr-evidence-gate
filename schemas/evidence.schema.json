{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pr-evidence-gate/pr-evidence-gate/schema/evidence-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "repository", "baseSha", "headSha", "verifier", "checks", "limitations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "repository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
    "pullRequestNumber": { "type": "integer", "minimum": 1 },
    "baseSha": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" },
    "headSha": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" },
    "verifier": { "type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": { "name": { "const": "pr-evidence-gate" }, "version": { "type": "string", "minLength": 1 } } },
    "checks": { "type": "array", "maxItems": 20, "items": { "type": "object", "additionalProperties": false, "required": ["kind", "status", "summary", "details"], "properties": { "kind": { "enum": ["regression", "imports", "linked-issue", "policy"] }, "status": { "enum": ["PASS", "FAIL", "INCONCLUSIVE", "SKIPPED", "ERROR"] }, "summary": { "type": "string", "minLength": 1, "maxLength": 500 }, "details": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 2000 } }, "files": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 500 } }, "durationMs": { "type": "integer", "minimum": 0 } } } },
    "limitations": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 2000 } }
  }
}
